{
  "name": "ink-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:release": "node scripts/dev.mjs --release",
    "build:wasm": "wasm-pack build engine --target web --out-dir ../src/wasm/pkg --out-name ink_engine",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
